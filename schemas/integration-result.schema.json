{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "classification": {
      "type": "string",
      "enum": [
        "INTEGRATED",
        "VALIDATION_FAILED",
        "HUMAN_DECISION_REQUIRED",
        "SEMANTIC_CONFLICT",
        "RETRYABLE_INTEGRATION_FAILURE",
        "TERMINAL_INTEGRATION_FAILURE"
      ]
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "gate_classification", "reason", "blocker_categories", "retryable"],
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "gate_classification": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "blocker_categories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "retryable": {"type": "boolean", "enum": [false]}
      }
    },
    "retryable": {"type": "boolean", "enum": [true]},
    "failure_classification": {
      "type": "string",
      "enum": [
        "build_failure", "implementation_validation_failure", "integration_validation_failure",
        "lint_failure", "packaging_failure", "review_findings", "session_execution_failed",
        "structured_output_invalid", "test_failure", "validation_failure"
      ]
    },
    "hypothesis": {"type": "string", "minLength": 1},
    "remediation_action": {"type": "string", "minLength": 1},
    "supporting_evidence": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "HUMAN_DECISION_REQUIRED"}}},
      "then": {"required": ["human_decision"]}
    },
    {
      "if": {"properties": {"classification": {"const": "RETRYABLE_INTEGRATION_FAILURE"}}},
      "then": {
        "required": ["retryable", "failure_classification", "hypothesis", "remediation_action", "supporting_evidence"]
      }
    }
  ]
}
