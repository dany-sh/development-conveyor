{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycle-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conveyor_run_id", "project_id", "repository_identity", "repository_path_fingerprint", "active_milestone", "current_feature", "feature_dependencies", "feature_branch", "feature_worktree", "feature_starting_commit", "accepted_feature_commit", "milestone_branch", "milestone_pre_integration_commit", "milestone_post_integration_commit", "current_phase", "writer_lock_identity", "validation_attempts", "review_attempts", "integration_attempts", "last_successful_checkpoint", "last_verified_git_state", "stop_reason", "human_decision_required", "resume_instructions", "session_id", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "conveyor_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "project_id": {"type": "string"},
    "repository_identity": {"type": "object"},
    "repository_path_fingerprint": {"type": "string"},
    "active_milestone": {"type": ["string", "null"]},
    "current_feature": {"type": ["string", "null"]},
    "selected_feature": {"type": ["string", "null"]},
    "feature_dependencies": {"type": "array", "items": {"type": "string"}},
    "dependency_evidence": {"type": "object"},
    "queue_fingerprint": {"type": ["string", "null"]},
    "feature_branch": {"type": ["string", "null"]},
    "feature_worktree": {"type": ["string", "null"]},
    "session_completion_classification": {"type": ["string", "null"]},
    "session_completion_flags": {"type": "array", "items": {"type": "string"}},
    "session_completion_evidence": {"type": ["object", "null"]},
    "branch_recovery": {"type": ["object", "null"]},
    "feature_starting_commit": {"type": ["string", "null"]},
    "accepted_feature_commit": {"type": ["string", "null"]},
    "milestone_branch": {"type": ["string", "null"]},
    "milestone_pre_integration_commit": {"type": ["string", "null"]},
    "milestone_post_integration_commit": {"type": ["string", "null"]},
    "current_phase": {"type": "string"},
    "writer_lock_identity": {"type": ["object", "null"]},
    "validation_attempts": {"type": "array", "items": {"type": "object"}},
    "review_attempts": {"type": "array", "items": {"type": "object"}},
    "integration_attempts": {"type": "array", "items": {"type": "object"}},
    "last_successful_checkpoint": {"type": ["string", "null"]},
    "last_verified_git_state": {"type": ["object", "null"]},
    "preflight_compatibility": {"type": ["object", "null"]},
    "failure_classification": {"type": ["string", "null"]},
    "retry_exhausted": {"type": "boolean"},
    "environment_remediation_verified": {"type": "boolean"},
    "next_safe_action": {"type": ["string", "null"]},
    "supersedes_run_id": {"type": ["string", "null"]},
    "supersedes_session_id": {"type": ["string", "null"]},
    "superseded_cycle_archive": {"type": ["object", "null"]},
    "stop_reason": {"type": ["string", "null"]},
    "human_decision_required": {"type": ["object", "null"]},
    "resume_instructions": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "feature_session_id": {"type": ["string", "null"]},
    "integration_session_id": {"type": ["string", "null"]},
    "prior_integration_session_ids": {"type": "array", "items": {"type": "string"}},
    "integration_status": {"type": ["string", "null"], "enum": [null, "pending", "ready", "running", "validation", "blocked", "passed", "failed"]},
    "integration_gate": {"type": ["object", "null"]},
    "integration_finalization_history": {"type": "array", "items": {"type": "object"}},
    "optional_warnings": {"type": "array", "items": {"type": "string"}},
    "validated_planning_baseline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "commit", "previous_validated_commit", "evidence_fingerprint", "reconciliation_run", "validated_at", "approval_resolution_id", "approval_resolution_fingerprint"],
          "properties": {
            "schema_version": {"type": "integer", "enum": [1]},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "previous_validated_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reconciliation_run": {"type": "string", "minLength": 1},
            "validated_at": {"type": "string", "minLength": 1},
            "approval_resolution_id": {"type": "string", "minLength": 1},
            "approval_resolution_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "milestone_gate_session_id": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
